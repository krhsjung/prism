# Coturn environment variables
# This compose project name
COMPOSE_PROJECT_NAME=coturn

COTURN_VERSION=4.6

# 인증·식별 — 실제 값은 셸 환경에서 온다(도메인·비밀을 레포에 넣지 않는다).
#
# COTURN_AUTH_SECRET은 앱의 PRISM_TURN_SECRET과 **같은 값**이어야 한다. 소켓이 통화
# 수락과 함께 내려주는 자격증명이 이 비밀로 서명되고, coturn이 같은 비밀로 검증한다.
# **이 값 자체는 클라이언트에게 나가지 않는다** — 나가는 것은 시한부 사용자명·서명뿐이다.
COTURN_REALM=${PRISM_SERVICE_DOMAIN}
COTURN_AUTH_SECRET=${PRISM_TURN_SECRET}  # openssl rand -hex 32

# NAT 뒤라면 공인 IP를 적는다(DDNS 도메인이 아니라 IP다 — coturn은 이 값을 조회 없이
# 그대로 후보에 싣는다). 비워 두면 컨테이너가 DNS로 스스로 찾는다.
COTURN_EXTERNAL_IP=${COTURN_EXTERNAL_IP:-}

# 릴레이 소켓을 묶을 주소. 비워 두면 컨테이너의 IPv4를 스스로 찾는다.
COTURN_RELAY_IP=${COTURN_RELAY_IP:-}

# 포트 — 릴레이 범위는 공유기에서도 UDP로 열어야 한다.
COTURN_LISTENING_PORT=${COTURN_LISTENING_PORT:-3478}
COTURN_TLS_PORT=${COTURN_TLS_PORT:-5349}
COTURN_MIN_PORT=${COTURN_MIN_PORT:-49100}
COTURN_MAX_PORT=${COTURN_MAX_PORT:-49200}

# 사설·예약 대역으로의 릴레이 허용(= SSRF 방어 해제). 로컬 시험에서만 true.
COTURN_ALLOW_PRIVATE_PEERS=${COTURN_ALLOW_PRIVATE_PEERS:-false}
COTURN_VERBOSE=${COTURN_VERBOSE:-false}
