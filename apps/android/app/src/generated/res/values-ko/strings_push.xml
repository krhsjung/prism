<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 푸시 — 내 기기에 알림을 보내 보는 화면(plan/push.md) -->
    <string name="push_title">푸시</string>
    <string name="push_desc">기기를 골라 알림을 보내 보세요.</string>

    <!-- 카드 바닥 한 줄 — 토큰이 어디에 사는지 말한다(§5-3). 목록 응답에 토큰이 실리지 않는 이유이기도 하다 -->
    <string name="push_foot">등록 토큰은 세션 안에 있고 서버 밖으로 나가지 않습니다. 로그아웃하면 함께 사라집니다.</string>

    <!-- 목록은 대시보드·WebRTC 로비와 같은 데이터다. 다른 것은 할 수 있는 일뿐이다 -->
    <string name="push_devices">기기로 보내기</string>
    <string name="push_devices_desc">등록된 기기가 알림을 받을 수 있습니다. 나머지는 아직입니다.</string>

    <!-- 여럿 고를 수 있다. 같은 설치가 여러 세션에 걸리면 서버가 합쳐 한 번만 보낸다(§5-10) -->
    <string name="push_select_all">모두 선택</string>
    <string name="push_clear_all">해제</string>
    <string name="push_selected_count">{count}개 선택됨</string>

    <!-- 고른 줄은 버튼 글자로 말한다 — 목록에 라디오를 따로 두면 누를 곳이 둘이 된다 -->
    <string name="push_select">선택</string>
    <string name="push_selected">선택됨</string>

    <!-- 제목은 선택이다 — 비우면 서버가 받는 기기의 언어로 그린다(server.csv의 demo_title) -->
    <string name="push_title_label">제목</string>
    <string name="push_title_placeholder">비우면 기본 제목이 쓰입니다</string>
    <string name="push_message_label">문구</string>
    <string name="push_message_placeholder">기기에 뜰 문구를 적으세요</string>
    <string name="push_send">보내기</string>

    <!-- 알림이 실을 수 있는 것들 — 셋 다 선택이다(§5-11 ~ §5-13) -->
    <string name="push_image_label">이미지</string>
    <string name="push_image_hint">공개 https 주소입니다. 아래 샘플은 이 사이트가 서빙합니다.</string>

    <!-- 그리는 것은 결국 OS다 — macOS Chrome은 시스템 알림 센터를 쓰고 거기엔 큰 그림 자리가 없다(§5-11) -->
    <string name="push_image_desktop_note">데스크톱 브라우저에서는 그림이 표시되지 않을 수 있습니다.</string>
    <string name="push_image_placeholder">https://example.com/photo.jpg</string>
    <string name="push_image_none">이미지 없음</string>
    <string name="push_link_label">링크</string>
    <string name="push_link_hint">알림을 누르면 여는 곳입니다.</string>
    <string name="push_link_placeholder">https://example.com</string>
    <string name="push_actions_label">버튼</string>
    <string name="push_actions_none">없음</string>
    <string name="push_actions_open">열기</string>
    <string name="push_actions_open_dismiss">열기와 닫기</string>

    <!-- 알림에 붙는 버튼의 문구. **서버가 보내지 않는다** — iOS는 등록 시점에 굳어 요청의 언어를 알 수 없다(§5-13) -->
    <string name="push_action_open">열기</string>
    <string name="push_action_dismiss">닫기</string>

    <!-- FCM이 알려 주는 것은 받아들였다까지다 — 배달도 열람도 알 수 없다 -->
    <string name="push_result_accepted">보냈습니다. 기기가 깨어 있으면 알림이 뜹니다.</string>

    <!-- 같은 설치가 여러 세션에 걸렸다 — 실패가 아니라 한 번만 보냈다는 사실이다(§5-5) -->
    <string name="push_result_duplicate">다른 줄과 같은 기기입니다 — 한 번만 보냈습니다.</string>
    <string name="push_result_unknown">그 세션이 사라졌습니다. 목록을 새로 고치세요.</string>
    <string name="push_result_no_token">그 기기에는 알림 토큰이 없습니다. 그 기기에서 다시 로그인하면 켜집니다.</string>
    <string name="push_result_rejected">Firebase가 그 기기의 토큰을 거부했습니다. 그 기기에서 다시 로그인하세요.</string>

    <!-- Android 알림 채널 이름 — 시스템 설정에 그대로 보인다. 통화와 데모를 가르는 이유는 하나를 끌 때 둘 다 꺼지지 않게 하려는 것이다 -->
    <string name="push_channel_calls">통화</string>
    <string name="push_channel_general">알림</string>

    <!-- 권한은 로그인 화면에서 먼저 받는다 — 토큰이 로그인 요청에 실려야 하기 때문이다(§5-2) -->
    <string name="push_allow">알림 켜기</string>
    <string name="push_allow_desc">앱이 닫혀 있어도 이 기기가 통화와 푸시를 받게 합니다.</string>
    <string name="push_allow_denied">이 앱의 알림이 차단돼 있습니다. 설정에서 다시 켜 주세요.</string>
    <string name="push_allow_unsupported">이 브라우저는 알림을 받을 수 없습니다.</string>
</resources>
