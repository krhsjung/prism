<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+(패키지 가시성): 카카오톡 앱 로그인 가능 여부를 조회하려면 필요하다. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".PrismApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Android"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 웹 redirect(flow=native) 로그인. 브라우저 탭을 열고, 서버 콜백
             (prism://auth/callback?code=…)을 커스텀 스킴으로 되받는다. 회전 재생성이
             취소로 오인되지 않도록 configChanges를 잡고, 콜백을 기존 인스턴스로 배달하도록
             singleTop으로 둔다. 투명 테마라 화면에 뜨지 않는다. -->
        <activity
            android:name=".feature.auth.WebAuthActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:path="/callback"
                    android:scheme="prism" />
            </intent-filter>
        </activity>

        <!-- 카카오톡 앱 로그인 후 앱으로 돌아오는 redirect(kakao{앱키}://oauth)를 받는다.
             스킴의 앱키는 build.gradle.kts의 manifestPlaceholders에서 채운다. -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>
    </application>

</manifest>