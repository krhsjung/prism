<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WebRTC의 NetworkMonitor가 `registerNetworkCallback`으로 회선 변화를 좇는다 —
         이 권한이 없으면 그 호출이 SecurityException을 내고, JNI 경계를 넘지 못한 예외가
         네이티브를 통째로 abort시킨다(화면에는 그냥 "앱이 죽었다"로 보인다). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 통화가 시작되는 순간(Call · Accept · Test)에만 묻는다. 화면을 연 것만으로는
         묻지 않는다(plan/webrtc.md §7: 명시적 사용자 제스처 후) — 권한 창이 뜨는
         시점 자체가 그 결정의 관찰 가능한 결과다. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 알림. **Android 13(33)부터만 런타임 권한이다** — minSdk 24라 그 아래에서는
         설치와 함께 허용된 것으로 다뤄야 하고, 화면도 묻지 않는다. 묻는 자리는 푸시
         화면의 `알림 켜기`다 — 로그인은 로그인만 한다(plan/push.md §5-2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라가 없는 기기(TV·일부 태블릿)에서도 설치는 되게 둔다 — 통화를 못 걸 뿐,
         대시보드는 그대로 쓸 수 있고 화면이 그 이유를 말한다. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+(패키지 가시성): 카카오톡 앱 로그인 가능 여부를 조회하려면 필요하다. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".PrismApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android">
        <!-- 알림을 눌러 들어오는 경로가 여기다. **singleTop**이라야 앱이 이미 떠 있을 때
             새 인스턴스를 쌓지 않고 `onNewIntent`로 배달된다 — 통화 알림은 앱이 열려
             있는 동안에도 온다(다른 화면을 보고 있을 때). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Android"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 웹 redirect(flow=native) 로그인. 브라우저 탭을 열고, 서버 콜백
             (prism://auth/callback?code=…)을 커스텀 스킴으로 되받는다. 회전 재생성이
             취소로 오인되지 않도록 configChanges를 잡고, 콜백을 기존 인스턴스로 배달하도록
             singleTop으로 둔다. 투명 테마라 화면에 뜨지 않는다. -->
        <activity
            android:name=".feature.auth.WebAuthActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:path="/callback"
                    android:scheme="prism" />
            </intent-filter>
        </activity>

        <!-- FCM 수신기 — **알림을 그리는 곳은 여기 하나다.** 서버가 Android에는 data만
             보내므로 앞이든 뒤든 `onMessageReceived`가 그린다(plan/push.md §5-20). -->
        <service
            android:name=".core.push.PrismMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- **안전망이다.** 서버는 이제 Android에 `notification` 블록을 보내지 않지만, 그런
             메시지가 한 번이라도 오면(배포 중 옛 서버 · 콘솔에서 보낸 시험 메시지) FCM SDK가
             대신 그린다. 그때 런처 아이콘으로 떨어지지 않게 **우리와 같은 아이콘**을 쥐여 둔다
             — 앞/뒤에서 아이콘이 갈렸던 것이 정확히 이 값이 없어서였다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="prism_general" />

        <!-- 알림의 `닫기` 버튼. 화면을 띄우지 않고 알림만 지운다(plan/push.md §5-13). -->
        <receiver
            android:name=".core.push.PushDismissReceiver"
            android:exported="false" />

        <!-- 카카오톡 앱 로그인 후 앱으로 돌아오는 redirect(kakao{앱키}://oauth)를 받는다.
             스킴의 앱키는 build.gradle.kts의 manifestPlaceholders에서 채운다. -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>
    </application>

</manifest>