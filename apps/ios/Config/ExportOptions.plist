<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight/App Store 업로드용 내보내기 옵션.
	     `xcodebuild -exportArchive -exportOptionsPlist Config/ExportOptions.plist` 가 읽는다.
	     destination=upload 라 .ipa 를 디스크에 남기지 않고 곧장 App Store Connect 로 보낸다.
	     manageAppVersionAndBuildNumber 는 이미 올라간 빌드 번호와 겹치면 Xcode 가 올려 준다. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>G9MQRF2U8G</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>
