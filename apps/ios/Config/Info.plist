<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- API(=auth 서비스) 주소. 값은 빌드 환경변수 PRISM_API_URL에서 온다 —
	     주소를 소스에 박지 않기 위한 통로이며, 웹의 VITE_API_URL과 같은 역할이다.
	     비어 있으면 APIConfiguration이 로컬 개발 서버로 떨어진다.

	     나머지 Info.plist 키(씬 매니페스트·런치 스크린·방향 등)는 Xcode가
	     GENERATE_INFOPLIST_FILE로 생성해 이 파일 위에 얹는다 — 여기에는 생성기가
	     모르는 커스텀 키만 둔다. -->
	<key>PRISM_API_URL</key>
	<string>$(PRISM_API_URL)</string>

	<!-- 세션 소켓(= socket 서비스) 주소. API와 **다른 포트**라(로컬 3000 vs 3002)
	     baseURL에서 유도할 수 없어 따로 둔다.

	     ⚠️ Secrets.xcconfig에 넣지 말 것 — xcconfig는 `//`를 주석으로 먹어
	     `wss://...`가 스킴에서 잘린다(PRISM_API_URL이 같은 이유로 여기 있다). -->
	<key>PRISM_SOCKET_URL</key>
	<string>$(PRISM_SOCKET_URL)</string>

	<!-- 통화가 시작되는 순간(Call · Accept · Test) 카메라·마이크를 묻는다. 화면을 연
	     것만으로는 묻지 않는다(plan/webrtc.md §7: 명시적 사용자 제스처 후) — 이 문구가
	     뜨는 시점 자체가 그 결정의 관찰 가능한 결과다. -->
	<key>NSCameraUsageDescription</key>
	<string>Prism uses your camera for 1:1 video calls to your own signed-in devices. Video is sent peer-to-peer and is never recorded or stored.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Prism uses your microphone for 1:1 video calls to your own signed-in devices. Audio is sent peer-to-peer and is never recorded or stored.</string>

	<!-- ── 네이티브 소셜 로그인 크리덴셜 ──
	     실제 값은 gitignore된 Config/Secrets.xcconfig가 빌드 변수로 채운다(커밋 소스에는
	     값이 없다). GoogleSignIn은 여기 GIDClientID를 읽고, URL 스킴은 iOS가 redirect
	     라우팅에 쓴다. -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>

	<!-- 외부 앱에서 우리 앱으로 돌아오는 redirect 스킴.
	       역순 구글 클라이언트 ID : Google 로그인 복귀
	       kakao{앱키}          : 카카오톡 로그인 복귀 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
	</array>

	<!-- 카카오톡 앱을 열 수 있는지 조회하려면 이 스킴들을 허용 목록에 둬야 한다(iOS). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
	</array>
</dict>
</plist>
