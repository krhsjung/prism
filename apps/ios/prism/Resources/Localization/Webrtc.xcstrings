    "webrtc.devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の端末"
          }
        }
      }
    },
    "webrtc.devices_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected devices ring right away. The rest can't be reached yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 기기는 바로 울립니다. 나머지는 아직 부를 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中の端末はすぐに鳴ります。それ以外にはまだ発信できません。"
          }
        }
      }
    },
    "webrtc.call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発信"
          }
        }
      }
    },
    "webrtc.will_notify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will notify"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 보냅니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を送ります"
          }
        }
      }
    },
    "webrtc.notifications_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 꺼짐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知オフ"
          }
        }
      }
    },
    "webrtc.no_other_devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other devices are signed in. Open Prism in another tab to call yourself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기가 로그인되어 있지 않습니다. 탭을 하나 더 열면 자신에게 걸 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の端末はサインインしていません。別のタブで開くと自分に発信できます。"
          }
        }
      }
    },
    "webrtc.this_tab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 탭"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブ"
          }
        }
      }
    },
    "webrtc.loopback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback test"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루프백 테스트"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ループバックテスト"
          }
        }
      }
    },
    "webrtc.test": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시험"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト"
          }
        }
      }
    },
    "webrtc.loopback_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback stays in this tab — nothing goes through the signaling server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루프백은 이 탭 안에서만 돕니다 — 시그널링 서버를 거치지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ループバックはこのタブ内で完結します — シグナリングサーバーを経由しません。"
          }
        }
      }
    },
    "webrtc.p2p_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video and audio go straight between your devices. Nothing is recorded or stored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상과 음성은 기기 사이로 바로 갑니다. 녹화하거나 저장하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像と音声は端末どうしで直接やり取りされます。録画も保存もしません。"
          }
        }
      }
    },
    "webrtc.in_call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In call"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 중"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中"
          }
        }
      }
    },
    "webrtc.calling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling {device}…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{device}에 거는 중…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} に発信中…"
          }
        }
      }
    },
    "webrtc.ringing_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the other device to answer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 받기를 기다리는 중입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の端末の応答を待っています。"
          }
        }
      }
    },
    "webrtc.ring_timeout_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls stop ringing after 45 seconds."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "45초가 지나면 호출이 끝납니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "45 秒を過ぎると呼び出しは終了します。"
          }
        }
      }
    },
    "webrtc.notified_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notified {device}. It has 45 seconds to answer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{device}에 알림을 보냈습니다. 45초 안에 받아야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} に通知しました。45 秒以内に応答が必要です。"
          }
        }
      }
    },
    "webrtc.tile_notified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the device to open…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 열리기를 기다리는 중…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が開かれるのを待っています…"
          }
        }
      }
    },
    "webrtc.incoming_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming call"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸려 오는 통화"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信"
          }
        }
      }
    },
    "webrtc.incoming_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} is calling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{device}에서 걸려 왔습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} から着信しています。"
          }
        }
      }
    },
    "webrtc.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答"
          }
        }
      }
    },
    "webrtc.decline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "webrtc.declined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device declined the call."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 통화를 거절했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の端末が通話を拒否しました。"
          }
        }
      }
    },
    "webrtc.expired_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That call already ended"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 끝난 통화입니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その通話はすでに終了しました"
          }
        }
      }
    },
    "webrtc.expired_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} called and the call has already ended. Call it back if you like."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{device}에서 걸었지만 통화는 이미 끝났습니다. 원하면 다시 걸어 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{device} から発信がありましたが、通話はすでに終了しています。必要なら折り返してください。"
          }
        }
      }
    },
    "webrtc.mute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute microphone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 끄기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをオフにする"
          }
        }
      }
