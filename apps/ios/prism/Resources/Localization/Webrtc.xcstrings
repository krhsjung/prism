          }
        }
      }
    },
    "webrtc.camera_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn camera on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
