    "webrtc.lobby_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a call"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 시작하기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話を始める"
          }
        }
      }
    },
    "webrtc.lobby_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a signed-in device to call. Your camera and mic turn on when the call starts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인된 기기 중 하나를 골라 거세요. 카메라와 마이크는 통화가 시작될 때 켜집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中の端末を選んで発信してください。カメラとマイクは通話の開始時にオンになります。"
          }
        }
      }
    },
    "webrtc.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
