          "stringUnit": {
            "state": "translated",
            "value": "Link"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク"
          }
        }
      }
    },
    "push.link_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the notification opens when it is tapped."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 누르면 여는 곳입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をタップしたときに開く場所です。"
          }
        }
      }
    },
    "push.link_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
