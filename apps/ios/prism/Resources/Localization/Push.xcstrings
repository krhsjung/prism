    "push.message_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the device should show"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 뜰 문구를 적으세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に表示する文言を入力"
          }
        }
      }
    },
