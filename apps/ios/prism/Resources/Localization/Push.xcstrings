    "push.image_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A public https address. Samples below are served by this site."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 https 주소입니다. 아래 샘플은 이 사이트가 서빙합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開 https アドレスです。下のサンプルはこのサイトが配信します。"
          }
        }
      }
    },
    "push.image_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
