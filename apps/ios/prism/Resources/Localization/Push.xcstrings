          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "push.actions_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        }
      }
    },
    "push.actions_open_dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and Dismiss"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기와 닫기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くと閉じる"
          }
        }
      }
    },
    "push.action_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        }
      }
    },
    "push.action_dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "push.result_accepted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent. It shows on that device if the device is awake."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보냈습니다. 기기가 깨어 있으면 알림이 뜹니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信しました。端末が起動していれば通知が表示されます。"
          }
        }
      }
    },
    "push.result_duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same device as another line — sent once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 줄과 같은 기기입니다 — 한 번만 보냈습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の行と同じ端末です — 一度だけ送信しました。"
          }
        }
      }
    },
    "push.result_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That session is gone. Refresh the list."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 세션이 사라졌습니다. 목록을 새로 고치세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのセッションはありません。一覧を更新してください。"
          }
        }
      }
    },
    "push.result_no_token": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device has no notification token. Sign in again on it to turn notifications on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 기기에는 알림 토큰이 없습니다. 그 기기에서 다시 로그인하면 켜집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末には通知トークンがありません。その端末で再度サインインすると有効になります。"
          }
        }
      }
    },
    "push.result_rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firebase rejected that device's token. Sign in again on that device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Firebase가 그 기기의 토큰을 거부했습니다. 그 기기에서 다시 로그인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Firebase がその端末のトークンを拒否しました。その端末で再度サインインしてください。"
          }
        }
      }
    },
    "push.channel_calls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話"
          }
        }
      }
    },
    "push.channel_general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "push.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 켜기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をオンにする"
          }
        }
      }
    },
    "push.allow_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets this device receive calls and pushes while the app is closed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫혀 있어도 이 기기가 통화와 푸시를 받게 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じていても、この端末が通話とプッシュを受け取れるようになります。"
          }
        }
      }
    },
    "push.allow_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 켜짐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知オン"
          }
        }
      }
    },
    "push.allow_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are blocked for this app. Turn them back on in your settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 알림이 차단돼 있습니다. 설정에서 다시 켜 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの通知はブロックされています。設定でオンに戻してください。"
          }
        }
      }
    },
    "push.allow_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This browser can't receive notifications."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브라우저는 알림을 받을 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザーは通知を受け取れません。"
          }
        }
      }
    },
    "push.reauth_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on for this device but this session started without them. Sign in again to turn them on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 알림은 켜져 있지만 이 세션은 알림 없이 시작됐습니다. 다시 로그인하면 켜집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の通知はオンですが、このセッションは通知なしで開始されました。再度サインインするとオンになります。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
