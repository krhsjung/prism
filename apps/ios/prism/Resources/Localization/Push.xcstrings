          "stringUnit": {
            "state": "translated",
            "value": "{count} selected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{count}개 선택됨"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} 件選択中"
          }
        }
      }
    },
