    "push.title_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to use the default"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비우면 기본 제목이 쓰입니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄なら既定のタイトルになります"
          }
        }
      }
    },
    "push.message_label": {
      "extractionState": "manual",
      "localizations": {
