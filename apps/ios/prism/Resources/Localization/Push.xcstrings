{
  "sourceLanguage": "en",
  "strings": {
    "push.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸시"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ"
          }
        }
      }
    },
    "push.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick devices and send them a notification."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 골라 알림을 보내 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を選んで通知を送ってみましょう。"
          }
        }
      }
    },
    "push.foot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration tokens live inside the session and never leave the server. They disappear when you sign out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록 토큰은 세션 안에 있고 서버 밖으로 나가지 않습니다. 로그아웃하면 함께 사라집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録トークンはセッション内にあり、サーバーの外に出ません。サインアウトすると一緒に消えます。"
          }
        }
      }
    },
    "push.devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to a device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기로 보내기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に送信"
          }
        }
      }
    },
    "push.devices_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered devices can receive a notification. The rest can't yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록된 기기가 알림을 받을 수 있습니다. 나머지는 아직입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済みの端末が通知を受け取れます。それ以外はまだです。"
          }
        }
      }
    },
    "push.select_all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 선택"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて選択"
          }
        }
      }
    },
    "push.clear_all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해제"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除"
          }
        }
      }
    },
