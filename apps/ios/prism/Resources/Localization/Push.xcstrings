          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタン"
          }
        }
      }
    },
    "push.actions_none": {
      "extractionState": "manual",
      "localizations": {
