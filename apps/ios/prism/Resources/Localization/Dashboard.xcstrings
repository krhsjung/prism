    "dashboard.placeholder_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re in. This is a placeholder dashboard for the authentication vertical slice — the demo login flow works end to end."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인됐습니다. 인증 vertical slice를 위한 임시 대시보드로, 데모 로그인 흐름이 처음부터 끝까지 동작합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインできました。認証の vertical slice 用の仮ダッシュボードで、デモログインの流れが最後まで動作します。"
          }
        }
      }
    },
