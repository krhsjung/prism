{
  "sourceLanguage": "en",
  "strings": {
    "dashboard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대시보드"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボード"
          }
        }
      }
    },
    "dashboard.signed_in_as": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in as {name}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} 님으로 로그인했습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} としてサインイン中"
          }
        }
      }
    },
    "dashboard.log_out": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃"
          }
        },
        "ja": {
          "stringUnit": {
