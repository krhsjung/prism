    "dashboard.sign_out_all_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of all devices?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての端末からサインアウトしますか？"
          }
        }
      }
    },
    "dashboard.sign_out_all_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session ends, including this one. You’ll need to sign in again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 세션을 포함해 모든 세션이 끊깁니다. 다시 로그인해야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションを含むすべてのセッションが終了します。もう一度サインインが必要です。"
          }
        }
      }
    },
