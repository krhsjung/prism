{
  "sourceLanguage": "en",
  "strings": {
    "error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again in a moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "error.signin_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign you in. Try again or use another method."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하지 못했습니다. 다시 시도하거나 다른 방법을 이용해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできませんでした。もう一度お試しになるか別の方法をご利用ください。"
          }
        }
      }
    },
    "error.demo_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo login is disabled right now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 데모 로그인을 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在デモログインはご利用いただけません。"
          }
        }
      }
    },
    "error.network_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost. Check your network and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊겼습니다. 네트워크를 확인하고 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。ネットワークを確認してもう一度お試しください。"
          }
        }
      }
    },
    "error.provider_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That sign-in method isn’t available in this app yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인 방법은 아직 앱에서 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインイン方法はまだアプリでご利用いただけません。"
          }
        }
      }
    },
    "error.logout_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t log you out. You’re still signed in — check your connection and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하지 못했습니다. 아직 로그인된 상태입니다 — 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトできませんでした。まだサインインしたままです — 接続を確認してもう一度お試しください。"
          }
        }
      }
    },
    "error.sessions_load_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load your sessions. Check your connection and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを読み込めませんでした。接続を確認してもう一度お試しください。"
          }
        }
      }
    },
    "error.revoke_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t sign out that session. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 세션을 로그아웃하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのセッションをサインアウトできませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "error.session_ended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended. Please sign in again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 종료되었습니다. 다시 로그인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが終了しました。もう一度サインインしてください。"
          }
        }
      }
    },
    "error.camera_permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism needs your camera and microphone. Allow access in your browser, then try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라와 마이크 권한이 필요합니다. 브라우저에서 허용한 뒤 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラとマイクへのアクセスが必要です。ブラウザで許可してからもう一度お試しください。"
          }
        }
      }
    },
    "error.camera_in_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using your camera. Close it and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 카메라를 쓰고 있습니다. 종료한 뒤 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがカメラを使用しています。終了してからもう一度お試しください。"
          }
        }
      }
    },
    "error.device_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device isn’t connected any more. Pick another one."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 기기는 더 이상 연결되어 있지 않습니다. 다른 기기를 골라 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末はもう接続されていません。別の端末を選んでください。"
          }
        }
      }
    },
    "error.device_busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device is already on a call."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 기기는 이미 통화 중입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末はすでに通話中です。"
          }
        }
      }
    },
    "error.no_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer. The call ended after 45 seconds."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "45초 동안 응답이 없어 통화가 끝났습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "45 秒間応答がなかったため通話を終了しました。"
          }
        }
      }
    },
    "error.device_unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device isn’t connected and has notifications off."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 기기는 연결되어 있지 않고 알림도 꺼져 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末は接続されておらず、通知もオフです。"
          }
        }
      }
    },
    "error.call_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect the call. Check your network and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화를 연결하지 못했습니다. 네트워크를 확인하고 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話を接続できませんでした。ネットワークを確認してもう一度お試しください。"
          }
        }
      }
    },
    "error.signaling_lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost the connection to the server. Reconnecting…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와의 연결이 끊겼습니다. 다시 연결하는 중…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとの接続が切れました。再接続しています…"
          }
        }
      }
    }
  },
  "version": "1.0"
}
