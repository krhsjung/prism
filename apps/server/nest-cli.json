{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "services/api/src",
  "monorepo": true,
  "root": "services/api",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "services/api/tsconfig.app.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "services/api",
      "entryFile": "main",
      "sourceRoot": "services/api/src",
      "compilerOptions": {
        "tsConfigPath": "services/api/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "services/auth",
      "entryFile": "main",
      "sourceRoot": "services/auth/src",
      "compilerOptions": {
        "tsConfigPath": "services/auth/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "push": {
      "type": "library",
      "root": "libs/push",
      "entryFile": "index",
      "sourceRoot": "libs/push/src",
      "compilerOptions": {
        "tsConfigPath": "libs/push/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "session": {
      "type": "library",
      "root": "libs/session",
      "entryFile": "index",
      "sourceRoot": "libs/session/src",
      "compilerOptions": {
        "tsConfigPath": "libs/session/tsconfig.lib.json"
      }
    },
    "socket": {
      "type": "application",
      "root": "services/socket",
      "entryFile": "main",
      "sourceRoot": "services/socket/src",
      "compilerOptions": {
        "tsConfigPath": "services/socket/tsconfig.app.json"
      }
    }
  }
}
