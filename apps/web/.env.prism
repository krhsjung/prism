# prism 빌드(`vite build --mode prism`)가 호출하는 API(=auth 서비스) 주소.
# 도메인은 환경변수 PRISM_SERVICE_DOMAIN에서 가져온다 — 빌드 환경에 설정돼 있어야 함.
VITE_API_URL=https://${PRISM_SERVICE_DOMAIN}

# 세션 소켓(= socket 서비스). nginx가 /socket을 NodePort 30002로 넘긴다.
# **wss여야 한다** — 세션 쿠키가 __Host- 접두어라 Secure를 요구하고,
# 평문 ws로는 쿠키가 실리지 않아 웹이 전부 인증에 실패한다.
VITE_SOCKET_URL=wss://${PRISM_SERVICE_DOMAIN}/socket
